{
    "name": "roundly-consulting/sentinel-for-laravel",
    "description": "Tamper-evident seals for Eloquent models (keyed MACs and signatures, key rotation, an append-only ledger with external anchors), idempotency keys, single-use nonces and URLs, and RFC 9421 HTTP message signatures.",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "eloquent",
        "integrity",
        "tamper-detection",
        "seals",
        "hmac",
        "signatures",
        "ledger",
        "audit",
        "idempotency",
        "nonce",
        "replay-protection",
        "http-message-signatures",
        "rfc9421"
    ],
    "homepage": "https://roundly-consulting.com/open-source/docs/sentinel-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://roundly-consulting.com/open-source/docs/sentinel-for-laravel"
    },
    "require": {
        "php": "^8.4",
        "ext-hash": "*",
        "ext-mbstring": "*",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/encryption": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/log": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "roundly-consulting/crypto-for-laravel": "^1.0",
        "roundly-consulting/enums-for-laravel": "^1.0",
        "roundly-consulting/package-toolkit-for-laravel": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.5",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "roundly-consulting/testing-for-laravel": "^1.0"
    },
    "suggest": {
        "ext-sodium": "Required for ed25519 seal keys and HTTP signatures (sign + verify); enabled by default on modern PHP."
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Sentinel\\": "src",
            "RoundlyConsulting\\Sentinel\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Sentinel\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": [
            "vendor/bin/pest --coverage --min=95 --coverage-clover=build/coverage.xml",
            "@php tests/Support/critical-coverage.php build/coverage.xml"
        ],
        "perf": "vendor/bin/pest --group=perf"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Sentinel\\SentinelServiceProvider"
            ]
        }
    }
}
