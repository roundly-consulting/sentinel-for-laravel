parameters:
    level: 7
    paths:
        - src
        - config
        - database
        # The sealable fixtures are the only users of the HasSeals trait; analysing them is
        # what makes PHPStan analyse the trait at all.
        - tests/Fixtures/Models
        - tests/Fixtures/Definitions
        # The host test case is the only user of the WithSentinelKeys trait.
        - tests/HostKeys/HostKeysTestCase.php
    # This package ships its own config/ dir; env() is correct there.
    configDirectories:
        - config
